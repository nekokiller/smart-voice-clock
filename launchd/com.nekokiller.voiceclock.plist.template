<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nekokiller.voiceclock</string>
    <key>ProgramArguments</key>
    <array>
        <string>__NODE__</string>
        <string>__ROOT__/server.js</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__ROOT__</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>__LOGDIR__/out.log</string>
    <key>StandardErrorPath</key>
    <string>__LOGDIR__/err.log</string>
</dict>
</plist>
